{
  "name": "@animae/web",
  "version": "1.0.0",
  "type": "module",
  "description": "WebSocket protocol and HTTP server for Animae game hosts",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts"
  },
  "publishConfig": {
